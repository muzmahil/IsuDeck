{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IsuDeck",
  "version": "1.2.0",
  "identifier": "IsuDeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IsuDeck",
        "width": 1200,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#121212",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
