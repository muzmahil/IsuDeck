{
  "name": "OBS Studio",
  "version": "1.0.0",
  "identifier": "com.isudeck.obsplugin",
  "daemon": true,
  "executable": "obs_plugin.exe",
  "description": "Official OBS Studio integration for IsuDeck. Connects via OBS WebSocket v5 to control program scenes, audio input mute states, streaming, and recording in real-time.",
  "author": "IsuDeck",
  "license": "MIT",
  "icon": "icon.png",
  "readme": "README.md",
  "config": [
    {
      "key": "ip",
      "type": "text",
      "label": "Server Host / IP",
      "placeholder": "127.0.0.1",
      "required": true,
      "value": "127.0.0.1"
    },
    {
      "key": "port",
      "type": "number",
      "label": "WebSocket Port",
      "placeholder": "4455",
      "required": true,
      "value": 4455
    },
    {
      "key": "password",
      "type": "password",
      "label": "Server Password",
      "placeholder": "Optional OBS WebSocket password",
      "required": false,
      "value": ""
    }
  ],
  "actions": [
    {
      "name": "change_scene",
      "label": "Change Scene",
      "icon": "icon.png",
      "fields": [
        {
          "key": "sceneName",
          "type": "dynamic_select",
          "label": "Target Scene",
          "placeholder": "Select a scene...",
          "source": "dynamic",
          "sourceKey": "GetScenes",
          "dataType": "GetScenes",
          "required": true
        }
      ]
    },
    {
      "name": "set_preview_scene",
      "label": "Set Preview Scene (Studio Mode)",
      "icon": "icon.png",
      "fields": [
        {
          "key": "sceneName",
          "type": "dynamic_select",
          "label": "Target Scene",
          "placeholder": "Select a preview scene...",
          "source": "dynamic",
          "sourceKey": "GetScenes",
          "dataType": "GetScenes",
          "required": true
        }
      ]
    },
    {
      "name": "toggle_mute",
      "label": "Toggle Mute (Microphone / Audio)",
      "icon": "icon.png",
      "fields": [
        {
          "key": "inputName",
          "type": "dynamic_select",
          "label": "Audio Source / Microphone",
          "placeholder": "Select an audio source (e.g. Mic/Aux)...",
          "source": "dynamic",
          "sourceKey": "GetInputs",
          "dataType": "GetInputs",
          "required": true
        }
      ]
    },
    {
      "name": "set_mute",
      "label": "Set Mute State",
      "icon": "icon.png",
      "fields": [
        {
          "key": "inputName",
          "type": "dynamic_select",
          "label": "Audio Source",
          "placeholder": "Select an audio source...",
          "source": "dynamic",
          "sourceKey": "GetInputs",
          "dataType": "GetInputs",
          "required": true
        },
        {
          "key": "muteState",
          "type": "select",
          "label": "Action",
          "options": [
            { "id": "mute", "label": "Mute" },
            { "id": "unmute", "label": "Unmute" }
          ],
          "default": "mute",
          "required": true
        }
      ]
    },
    {
      "name": "set_input_volume",
      "label": "Set Audio Volume Level",
      "icon": "icon.png",
      "fields": [
        {
          "key": "inputName",
          "type": "dynamic_select",
          "label": "Audio Source",
          "placeholder": "Select an audio source...",
          "source": "dynamic",
          "sourceKey": "GetInputs",
          "dataType": "GetInputs",
          "required": true
        },
        {
          "key": "volumePercent",
          "type": "number",
          "label": "Volume (0 - 100%)",
          "placeholder": "100",
          "required": true
        }
      ]
    },
    {
      "name": "toggle_record",
      "label": "Toggle Recording",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "start_record",
      "label": "Start Recording",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "stop_record",
      "label": "Stop Recording",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "toggle_record_pause",
      "label": "Pause / Resume Recording",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "toggle_stream",
      "label": "Toggle Streaming",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "start_stream",
      "label": "Start Streaming",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "stop_stream",
      "label": "Stop Streaming",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "toggle_virtual_cam",
      "label": "Toggle Virtual Camera",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "start_virtual_cam",
      "label": "Start Virtual Camera",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "stop_virtual_cam",
      "label": "Stop Virtual Camera",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "toggle_replay_buffer",
      "label": "Start / Stop Replay Buffer",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "save_replay_buffer",
      "label": "Save Replay Buffer",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "toggle_studio_mode",
      "label": "Toggle Studio Mode",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "trigger_studio_transition",
      "label": "Studio Mode Transition (Cut/Fade)",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "take_screenshot",
      "label": "Take Program Screenshot",
      "icon": "icon.png",
      "fields": []
    },
    {
      "name": "toggle_source_visibility",
      "label": "Toggle Source Visibility (Scene Item)",
      "icon": "icon.png",
      "fields": [
        {
          "key": "sceneName",
          "type": "dynamic_select",
          "label": "Scene Name",
          "placeholder": "Select scene...",
          "source": "dynamic",
          "sourceKey": "GetScenes",
          "dataType": "GetScenes",
          "required": true
        },
        {
          "key": "sourceName",
          "type": "dynamic_select",
          "label": "Source / Layer Name",
          "placeholder": "Select source or layer...",
          "source": "dynamic",
          "sourceKey": "GetSceneItems",
          "dataType": "GetSceneItems",
          "required": true
        }
      ]
    },
    {
      "name": "set_source_visibility",
      "label": "Set Source Visibility",
      "icon": "icon.png",
      "fields": [
        {
          "key": "sceneName",
          "type": "dynamic_select",
          "label": "Scene Name",
          "placeholder": "Select scene...",
          "source": "dynamic",
          "sourceKey": "GetScenes",
          "dataType": "GetScenes",
          "required": true
        },
        {
          "key": "sourceName",
          "type": "dynamic_select",
          "label": "Source / Layer Name",
          "placeholder": "Select source or layer...",
          "source": "dynamic",
          "sourceKey": "GetSceneItems",
          "dataType": "GetSceneItems",
          "required": true
        },
        {
          "key": "visibility",
          "type": "select",
          "label": "Visibility",
          "options": [
            { "id": "show", "label": "Show" },
            { "id": "hide", "label": "Hide" }
          ],
          "default": "show",
          "required": true
        }
      ]
    }
  ]
}
