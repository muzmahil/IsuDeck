# ==========================================
# IsuDeck Master .gitignore
# ==========================================

# --- Rust & Cargo Artifacts ---
target/
**/target/
**/*.rs.bk
Cargo.lock.temp

# --- Node.js & Dependencies ---
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!*.yarn/patches
!*.yarn/plugins
!*.yarn/releases
!*.yarn/versions

# --- Frontend & Build Outputs ---
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
*.tsbuildinfo

# --- Runtime & User Data ---
# User local test profiles and settings (prevent repository pollution)
profiles.json
settings.json
variables.json
config.json
**/config.json
*.log
install.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Built Binaries ---
# Built application binaries and archives (distributed via GitHub Releases)
IsuDeck.exe
IsuDeck-Linux-x64
*.pdb
*.ilk
*.exp
release_package/
*.zip
*.tar.gz
*.7z

# Keep driver installer and helper libraries in repository:
!drivers/install-interception.exe
!drivers/install_helper.cmd
!interception.dll

# --- Environment & Secrets ---
.env
.env*.local
*.pem

# --- OS & IDE Temporary Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
